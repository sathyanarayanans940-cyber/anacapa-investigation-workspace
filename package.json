{
  "name": "anacapa",
  "version": "0.4.1",
  "private": true,
  "description": "Local investigation boards and nested timelines.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node runtime/server.mjs --open",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-app.mjs",
    "validate": "node scripts/validate-release.mjs",
    "pretest": "node scripts/build.mjs --model-only",
    "test:pwa": "node tests/pwa-smoke.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node --experimental-strip-types scripts/benchmark.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "prettier": "3.9.10",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
